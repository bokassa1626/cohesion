NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173
CLIENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
DATA_ENCRYPTION_KEY=replace-with-32-plus-random-characters
OTP_EXPIRES_MINUTES=10
CAPTCHA_BYPASS_TOKEN=COHESION-DEV-CAPTCHA

# SMTP for email verification, 2FA and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Cohesion fraternelle <noreply@example.com>

# Firebase / Cloud adapters to configure for production.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# Cloudinary media storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment providers. Replace simulators with official provider APIs.
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
MOBILE_MONEY_WEBHOOK_SECRET=

# Push/SMS providers.
FCM_SERVER_KEY=
SMS_PROVIDER_API_KEY=
